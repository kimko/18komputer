{
  "name": "18komputer",
  "private": true,
  "version": "1.0.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "lint": "oxlint -D warnings && eslint src --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --project=chromium",
    "test:e2e:local": "TEST_ENV=local npx playwright test --project=chromium",
    "test:e2e:ci": "TEST_ENV=ci npx playwright test --project=chromium",
    "test:e2e:prod": "TEST_ENV=prod npx playwright test tests/version.spec.js --project=chromium",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "framer-motion": "^12.43.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "csv-parse": "^7.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-oxlint": "^1.77.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "oxlint",
      "eslint --fix"
    ]
  }
}
